# ── Agent Mode ──────────────────────────────────────────────────────────────────
# "claude"  → Anthropic API + Clay/Vibe via HTTP MCP
# "custom"  → OpenRouter API + Clay/Vibe via direct REST API calls
AGENT_MODE=claude

# ── LLM Keys ────────────────────────────────────────────────────────────────────
# Required when AGENT_MODE=claude
ANTHROPIC_API_KEY=                        # required when AGENT_MODE=claude
# Required when AGENT_MODE=custom
OPENROUTER_API_KEY=                       # required when AGENT_MODE=custom
OPENROUTER_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free

# ── Enrichment Keys ─────────────────────────────────────────────────────────────
# Required when AGENT_MODE=custom
APOLLO_API_KEY=                            # paid plan needed for full search
# Required when AGENT_MODE=custom
CLAY_API_KEY=                              # required when AGENT_MODE=custom
# Required when AGENT_MODE=custom
VIBE_API_KEY=                              # required when AGENT_MODE=custom

# ── Notifications ───────────────────────────────────────────────────────────────
# Optional: Slack Block Kit summaries
SLACK_WEBHOOK_URL=                        # optional — Slack Block Kit summaries

# ── Email Sending (SMTP) ──────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Your Gmail / SMTP address
SMTP_USER=                                # your Gmail / SMTP address
# Gmail app password (not your login password)
SMTP_PASSWORD=                            # app password (not your login password)
SMTP_FROM_NAME=VoiceCare.ai

# ── Pipeline Config ──────────────────────────────────────────────────────────────
DAILY_PROSPECT_LIMIT=20
# Sum of specificity+relevance+naturalness
QUALITY_THRESHOLD=2.4                     # sum of specificity+relevance+naturalness

# ── Persistence ──────────────────────────────────────────────────────────────────
DB_PATH=voicecare.db                      # SQLite file (LangGraph checkpoints + business data)
